#!/usr/bin/env bpftrace
/*
 * trace_aven.bt — eBPF Uprobe Tracing for Aven Generated Binaries
 *
 * Attaches to the non-inlined, exported symbol 'aven_ProductionProfile'
 * generated by `avenc build --emit-c --traceable`.
 *
 * Usage:
 *   bpftrace trace_aven.bt /opt/aven/bin/server_capacity
 */

BEGIN
{
    printf("Tracing Aven ProductionProfile latency... Hit Ctrl-C to finish.\n");
}

uprobe:$1:aven_ProductionProfile
{
    @start[tid] = nsecs;
}

uretprobe:$1:aven_ProductionProfile
/@start[tid]/
{
    $duration = nsecs - @start[tid];
    @latency_ns = hist($duration);
    @calls = count();
    delete(@start[tid]);
}

END
{
    printf("\nExecution Latency Distribution (nanoseconds):\n");
}
