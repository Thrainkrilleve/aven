// weather_nowcast.aven - Radar Atmospheric Nowcasting Model
// Real-time sensor fusion & physical boundary verification for radar tiles.
//
// Formulates kinematic continuity, hydrostatic balance, Clausius-Clapeyron
// moisture saturation, Marshall-Palmer radar reflectivity, and wind shear.

relation RadarAtmosphericCell {
    // ----------------------------------------------------
    // 1. Kinematic Continuity & Divergence
    // ----------------------------------------------------
    // Horizontal divergence: div_h = du/dx + dv_dy
    div_horizontal = du_dx + dv_dy

    // Incompressibility / continuity proxy: vertical velocity proxy w ≈ -div_h
    // Moisture flux term accounts for updraft moisture convergence
    vertical_velocity_proxy = -div_horizontal - moisture_g_kg * 0.001

    // ----------------------------------------------------
    // 2. Hydrostatic Balance Proxy
    // ----------------------------------------------------
    // Discretized barometric equation: dP/dz = -P * g / (R_d * T)
    // R_d = 287.056 J/(kg·K), g = 9.81 m/s²
    dP_dz = -pressure_hpa * 9.80665 / (287.056 * temperature_k)

    // ----------------------------------------------------
    // 3. Clausius-Clapeyron Moisture Saturation
    // ----------------------------------------------------
    // Magnus-Tetens approximation for saturation vapor pressure over water (hPa)
    temp_c = temperature_k - 273.15
    e_sat_hpa = 6.112 * exp(17.67 * temp_c / (temp_c + 243.5))

    // Actual water vapor partial pressure from specific humidity: e ≈ P * q / 0.622
    // moisture_g_kg is in g/kg, so specific humidity q = moisture_g_kg / 1000.0
    actual_vapor_pressure_hpa = pressure_hpa * (moisture_g_kg / 1000.0) / 0.622

    // Saturation deficit (positive = undersaturated, negative = supersaturated)
    saturation_deficit_hpa = e_sat_hpa - actual_vapor_pressure_hpa

    // Relative humidity percentage (%)
    relative_humidity = (actual_vapor_pressure_hpa / e_sat_hpa) * 100.0

    // ----------------------------------------------------
    // 4. Marshall-Palmer Radar Reflectivity
    // ----------------------------------------------------
    // Z = A * R^B where A = 200, B = 1.6 (rain rate R in mm/hr)
    z_linear = 200.0 * (precip_rate_mmh ^ 1.6)

    // Radar reflectivity factor in decibels (dBZ = 10 * log10(Z))
    // log10(Z) = ln(Z) / ln(10) where ln(10) ≈ 2.302585092994046
    radar_dbz = 10.0 * (log(z_linear) / 2.302585092994046)

    // ----------------------------------------------------
    // 5. Total Wind Shear & Microburst Hazard
    // ----------------------------------------------------
    // Horizontal wind speed magnitude
    wind_speed = sqrt(wind_u * wind_u + wind_v * wind_v)

    // Total horizontal deformation / shear rate (1/s)
    total_shear_rate = abs(du_dx) + abs(dv_dy)

    // Scaled shear per kilometer (m/s per km)
    shear_per_km = total_shear_rate * 1000.0
}

solve RadarAtmosphericCell with {
    // Atmospheric state observations (METAR & satellite sounding)
    temperature_k = 294.15
    pressure_hpa = 1013.25
    moisture_g_kg = 9.2

    // Wind vector observations (Doppler radar radial velocity retrieval)
    wind_u = 14.2
    wind_v = 8.6
    du_dx = 0.0003
    dv_dy = 0.0002

    // Radar estimated surface precipitation rate (mm/hr)
    precip_rate_mmh = 18.5

    // Physical safety envelopes and realism constraints
    temperature_k >= 250.0
    temperature_k <= 320.0
    shear_per_km <= 25.0
    relative_humidity <= 105.0
}