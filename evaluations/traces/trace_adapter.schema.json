{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TraceAdapterOutput",
  "type": "object",
  "required": [
    "reqs_per_second",
    "avg_latency_ms",
    "avg_payload_kb",
    "step_index",
    "timestamp_ms",
    "ttl_ms"
  ],
  "properties": {
    "reqs_per_second": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 500000.0
    },
    "avg_latency_ms": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 5000.0
    },
    "avg_payload_kb": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 10000.0
    },
    "step_index": {
      "type": "number",
      "minimum": 0.0
    },
    "timestamp_ms": {
      "type": "number",
      "minimum": 0.0
    },
    "ttl_ms": {
      "type": "number",
      "minimum": 0.0
    }
  }
}
