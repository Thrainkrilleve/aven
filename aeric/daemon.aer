# AERIC runtime config -- server_capacity / ProductionProfile
# Loaded by aeric_daemon (see aeric/README.md). key = value, '#' comments.
n_inputs      = 8
n_outputs     = 5
recover_ticks = 3
tick_hz       = 50
deadline_ms   = 18        # must be < tick period (1000/tick_hz ms) to hold the rate
tcp_port      = 5555
max_ticks     = 120        # 0 = run forever (real daemon); 120 ~= 2.4 s demo
ledger        = aeric_ledger.jsonl
seal_key      = aven-aeric-demo-key-v1   # production: prefer seal_key_env
# seal_key_env = AERIC_SEAL_KEY
safe          = 0, 1, 4096, 0, 0
