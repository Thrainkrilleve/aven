{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeBuildCommand": "npm run build:editor",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run build:editor"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  },
  "productName": "Aven Orchestrator",
  "mainBinaryName": "Aven Orchestrator",
  "version": "0.1.0",
  "identifier": "com.aven.orchestrator",
  "plugins": {},
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "Aven Orchestrator",
        "width": 1400,
        "height": 900,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}