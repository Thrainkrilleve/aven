{
  "Physical Relation": {
    "prefix": "relation",
    "body": [
      "relation ${1:Name} {",
      "    ${2:output} = ${3:input} * ${4:factor}",
      "}"
    ],
    "description": "Define a physical relation block"
  },
  "IPC External Relation": {
    "prefix": "relation-ipc",
    "body": [
      "relation ${1:LiveSensor} using ipc(\"${2:127.0.0.1:9090}\") {",
      "    ${3:derived_value} = ${4:observed_value} * ${5:1.0}",
      "}"
    ],
    "description": "Relation whose facts come from a persistent TCP daemon"
  },
  "Solve Block": {
    "prefix": "solve",
    "body": [
      "solve ${1:RelationName} with {",
      "    ${2:input_var} = ${3:100.0}",
      "}"
    ],
    "description": "Define a coupled solving query block"
  },
  "Optimization Solve Block": {
    "prefix": "solve-opt",
    "body": [
      "solve ${1:RelationName} with {",
      "    int ${2:replicas}",
      "    ${3:capacity} >= ${4:100.0}",
      "    minimize(${5:cost})",
      "}"
    ],
    "description": "Define an integer / branch-and-bound optimization solve block"
  },
  "Forward Block": {
    "prefix": "forward",
    "body": [
      "forward ${1:BlockName} {",
      "    ${2:output} = ${3:expression}",
      "}"
    ],
    "description": "Define a forward causal DAG compute block"
  },
  "Unit Declaration": {
    "prefix": "unit",
    "body": [
      "unit ${1:dimension_name} : ${2:unit_a}, ${3:unit_b}"
    ],
    "description": "Declare units of a new dimension (they convert only among themselves)"
  },
  "Typed Signal": {
    "prefix": "signal",
    "body": [
      "signal ${1:name} : ${2:km/h}"
    ],
    "description": "Declare the unit a variable is read and shown in"
  }
}