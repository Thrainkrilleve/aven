{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Aven",
  "scopeName": "source.aven",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#units"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.aven",
          "match": "//.*$"
        },
        {
          "name": "comment.block.aven",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.aven",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.aven",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "units": {
      "patterns": [
        {
          "comment": "signal <name> : <unit>",
          "match": "\\b(signal)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*([A-Za-z$][A-Za-z0-9_$]*(?:[/*\\^][A-Za-z0-9_$]+)*)",
          "captures": {
            "1": {
              "name": "keyword.control.aven"
            },
            "2": {
              "name": "variable.other.aven"
            },
            "3": {
              "name": "punctuation.separator.aven"
            },
            "4": {
              "name": "support.type.unit.aven"
            }
          }
        },
        {
          "comment": "a unit written after a number on a solve-block line: 250 km/h",
          "match": "(?<=[0-9.])\\s+([A-Za-z$][A-Za-z0-9_$]*(?:[/*\\^][A-Za-z0-9_$]+)*)\\s*(?=$|//)",
          "captures": {
            "1": {
              "name": "support.type.unit.aven"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.aven",
          "match": "\\b(relation|forward|solve|with|using|signal|unit|import)\\b"
        },
        {
          "name": "keyword.operator.optimization.aven",
          "match": "\\b(minimize|maximize)\\b"
        },
        {
          "name": "support.function.backend.aven",
          "match": "\\b(external|ipc|shm|native)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.aven",
          "match": "\\b(int|integer)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.aven",
          "match": "\\b(abs|ceil|floor|round|sign|sqrt|exp|log|ln|sin|cos|tan)\\b"
        },
        {
          "name": "constant.language.aven",
          "match": "\\b(pi|PI|e|E|tau|TAU)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.aven",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b|\\b[0-9]+[eE][+-]?[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.aven",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.aven",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.aven",
          "match": "(=)"
        },
        {
          "name": "keyword.operator.arithmetic.aven",
          "match": "(\\+|-|\\*|/|\\^)"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.aven",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}