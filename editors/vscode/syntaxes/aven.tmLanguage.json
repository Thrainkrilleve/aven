{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Aven",
  "scopeName": "source.aven",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#units" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.aven",
          "match": "//.*$"
        },
        {
          "name": "comment.block.aven",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.aven",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.aven",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "units": {
      "patterns": [
        {
          "name": "support.type.unit.aven",
          "match": "\\[([a-zA-Z0-9_\\*\\/\\^%]+)\\]"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.aven",
          "match": "\\b(relation|solve|with|forward|external|using|model|constraint|solver|objective|input|output|schema)\\b"
        },
        {
          "name": "keyword.operator.optimization.aven",
          "match": "\\b(minimize|maximize|in)\\b"
        },
        {
          "name": "keyword.other.ipc.aven",
          "match": "\\b(ipc)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.aven",
          "match": "\\b(int|integer|float|float32|float64|int32|int64|const|var|let)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.aven",
          "match": "\\b(abs|ceil|floor|round|sqrt|exp|log|ln|sin|cos|tan|pow|min|max)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.aven",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b|\\b[0-9]+[eE][+-]?[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.aven",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.aven",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.aven",
          "match": "(=|<-)"
        },
        {
          "name": "keyword.operator.arithmetic.aven",
          "match": "(\\+|-|\\*|/|\\^|%)"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.aven",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
