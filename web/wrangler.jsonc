{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avenc-web",
  "main": "src/index.ts",
  "compatibility_date": "2024-10-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "avenc.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "avenc_db",
      "database_id": "d8aaf321-ccdb-4997-a557-e9a65d98ad68",
      "migrations_dir": "./migrations"
    }
  ],
  // The live weather nowcast (/weather): a site at minutes 0 and 2 of every 5, scoring at
  // minute 4 (see TASKS_BY_CRON in src/weather/cycle.ts)
  "triggers": {
    "crons": ["*/5 * * * *", "2-59/5 * * * *", "4-59/5 * * * *"]
  },
  "vars": {
    "AVEN_VERSION": "0.6.0",
    "REGISTRY_URL": "https://avenc.dev",
    "ENVIRONMENT": "production"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}