{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avenc-web",
  "main": "src/index.ts",
  "compatibility_date": "2024-10-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "avenc_db",
      "database_id": "d8aaf321-ccdb-4997-a557-e9a65d98ad68",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "AVEN_VERSION": "0.9.0",
    "REGISTRY_URL": "https://avenc.dev",
    "ENVIRONMENT": "production"
  }
}
