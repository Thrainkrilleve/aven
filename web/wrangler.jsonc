{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avenc-web",
  "main": "src/index.ts",
  "compatibility_date": "2024-10-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "placement": {
    "mode": "smart"
  },
  "routes": [
    {
      "pattern": "avenc.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "avenc_db",
      "database_id": "d8aaf321-ccdb-4997-a557-e9a65d98ad68",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "AVEN_VERSION": "0.9.0",
    "REGISTRY_URL": "https://avenc.dev",
    "ENVIRONMENT": "production"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "issues": {
      "enabled": true
    },
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  // `npx wrangler preview` refuses to run without this block. Vars and D1 are
  // not inherited from the top level. There is no separate preview database.
  "previews": {
    "vars": {
      "AVEN_VERSION": "0.9.0",
      "REGISTRY_URL": "https://avenc.dev",
      "ENVIRONMENT": "preview"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "avenc_db",
        "database_id": "d8aaf321-ccdb-4997-a557-e9a65d98ad68",
        "migrations_dir": "./migrations"
      }
    ]
  }
}