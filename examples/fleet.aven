// examples/fleet.aven — Fleet Economics & Trip Model
//
// Money, counts and rates — all abstract quantities, so every signal is : scalar.
signal price       : scalar
signal units       : scalar
signal revenue     : scalar
signal cost        : scalar
signal profit      : scalar
signal distance    : scalar
signal speed       : scalar
signal time        : scalar
signal consumption : scalar
signal fuel        : scalar
signal price_fuel  : scalar

relation Economics {
    revenue = price * units
    profit  = revenue - cost
}

forward Trip {
    distance = speed * time
    fuel     = distance * consumption
    cost     = fuel * price_fuel
}

solve Trip with {
    speed       = 90
    time        = 4
    consumption = 0.07
    price_fuel  = 1.75
}

solve Economics with {
    profit = 500
    price  = 25
}
